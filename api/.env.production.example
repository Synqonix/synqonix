# Copy to api/.env.production (never commit it) and replace every value.
# Read by the `api` container and, for POSTGRES_PASSWORD, by the `postgres` container
# (see docker-compose.prod.yml).

NODE_ENV=production
PORT=4000

# The password here must match the one inside DATABASE_URL.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://synqonix:change-me@postgres:5432/synqonix

# Public address of the web app, as users' browsers see it (behind your TLS proxy).
WEB_URL=https://app.example.com

# Two different random strings, 32+ characters each:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# To rotate a JWT secret without signing everyone out, move the old value here (comma separated).
JWT_ACCESS_SECRET_PREVIOUS=
JWT_REFRESH_SECRET_PREVIOUS=

# Encrypts secrets stored in the database (webhook signing secrets). A third, different random string:
#   openssl rand -base64 48
# Keep it safe: losing it makes stored secrets unreadable. To rotate, move the old value to
# ENCRYPTION_KEY_PREVIOUS (comma separated) and set a new one.
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# Email (Resend), required: sign-up, password resets and notifications all send mail.
# MAIL_FROM's domain must be verified in Resend. Leave RESEND_BASE_URL unset in production.
RESEND_API_KEY=
MAIL_FROM=Synqonix <no-reply@example.com>

# File storage. `local` writes to the container's disk (needs the uploads volume); `s3` uses any S3-compatible
# bucket. Files always travel through short-lived presigned links, so the bucket can stay private.
STORAGE_DRIVER=local
S3_ENDPOINT=https://s3.filebase.com
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=1
PRESIGN_TTL_SECONDS=300
# Public address of this API (only used by the local driver's links)
API_PUBLIC_URL=https://api.example.com

# Reverse-proxy hops in front of the API (1 for a single nginx/Caddy/ALB).
TRUST_PROXY=1

# Optional: enables GET /api/v1/metrics for Prometheus (Authorization: Bearer <token>). 16+ characters.
METRICS_TOKEN=

# Optional GitHub App (see docs/github-integration.md)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Optional error reporting (Sentry or compatible). Unset: nothing is sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Only for several API instances (shares realtime, rate limits and job locks). Leave empty for one instance.
REDIS_URL=
REDIS_PREFIX=sqx:
