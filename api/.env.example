NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://synqonix:synqonix@localhost:5432/synqonix
WEB_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Encrypts secrets stored in the database (32+ characters).
ENCRYPTION_KEY=change-me-encryption-key-000000000000
# Email goes through Resend. In development the same SDK talks to Dev-Remail
# (docker compose -f docker-compose.dev.yml up -d; mailbox at http://localhost:6245): any key works,
# and synqonix.local is registered as a sending domain for you.
RESEND_API_KEY=re_dev
RESEND_BASE_URL=http://localhost:6245
MAIL_FROM="Synqonix <no-reply@synqonix.local>"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# GitHub App (leave empty to switch the GitHub integration off)
# Create an app with webhook URL <api>/api/v1/github/webhooks and setup URL <api>/api/v1/github/setup.
# Permissions: Contents (read & write), Pull requests (read), Issues (read & write), Checks (read), Metadata (read).
# Events: push, pull_request, pull_request_review, check_run, issues, installation, installation_repositories.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Outbound webhooks: only for local development, allows http and private/loopback targets
WEBHOOKS_ALLOW_PRIVATE_TARGETS=0

# Nightly cleanup (days; 0 keeps forever)
AUDIT_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90
DELIVERY_RETENTION_DAYS=30

# Files: `local` (disk) or `s3` (any S3-compatible bucket; see docs/deploy-free-tier.md)
STORAGE_DRIVER=local
